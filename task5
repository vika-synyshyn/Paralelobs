#include <iostream>
#include <thread>
#include <list>
#include <algorithm>
#include <mutex>
#include <future>
#include <vector>
#include <utility>

using namespace std;


list<int> l;
mutex listMutex;

template <typename Function>
future<void> RunDetached(Function action) {
    packaged_task<void()> task(action);
    future<void> result = task.get_future();

    thread worker(move(task));
    worker.detach();

    return result;
}

void AddToList(int number) {
    lock_guard<mutex> protection(listMutex);

    l.push_back(number);

    cout << "[ADD] Number " << number
        << " added to the list\n";
}

void ListContains(int number) {
    lock_guard<mutex> protection(listMutex);

    bool found =
        find(l.begin(), l.end(), number) != l.end();

    cout << "[CHECK] Number " << number
        << (found ? " is present\n" : " is absent\n");
}

int main() {
    int firstNumber = 10;
    int searchedNumber = 15;

    cout << "Adding numbers: " << firstNumber
        << ".." << firstNumber + 9 << '\n'
        << "Searching for: " << searchedNumber << "\n\n";

    vector<future<void>> results;

    for (int i = 0; i < 10; ++i) {
        int number = firstNumber + i;

        results.push_back(
            RunDetached([number] {
                AddToList(number);
                })
        );

        results.push_back(
            RunDetached([searchedNumber] {
                ListContains(searchedNumber);
                })
        );
    }

    for (auto& result : results) {
        result.get();
    }

    cout << "\nFinal list: ";

    for (int number : l) {
        cout << number << ' ';
    }

    cout << "\nElements: " << l.size() << '\n';

    return 0;
}
