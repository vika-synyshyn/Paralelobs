#include <iostream>
#include <thread>
#include <list>
#include <algorithm>
#include <mutex>

using namespace std;

list<int> l;
mutex listMutex;

void AddToList(int firstNumber) {
    for (int i = 0; i < 10; ++i) {
        int number = firstNumber + i;

        listMutex.lock();

        l.push_back(number);

        cout << "[ADD] Number " << number
            << " added to the list\n";

        listMutex.unlock();
    }
}

void ListContains(int number) {
    for (int i = 0; i < 10; ++i) {
        listMutex.lock();

        bool found =
            find(l.begin(), l.end(), number) != l.end();

        cout << "[CHECK] Number " << number
            << (found ? " is present\n" : " is absent\n");

        listMutex.unlock();
    }
}

int main() {
    int firstNumber = 10;
    int searchedNumber = 15;

    cout << "Adding numbers: " << firstNumber
        << ".." << firstNumber + 9 << '\n'
        << "Searching for: " << searchedNumber << "\n\n";

    thread writer(AddToList, firstNumber);
    thread reader(ListContains, searchedNumber);

    writer.join();
    reader.join();

    cout << "\nFinal list: ";

    for (int number : l) {
        cout << number << ' ';
    }

    return 0;
}
